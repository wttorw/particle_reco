#!/bin/sh

# build the whole project: three core libraries, one library per plugin,
# and one executable per combination of analyzers.
# ROOT must be set up first: source <root_install_dir>/bin/thisroot.sh

cd `dirname $0`
export ANALYSIS_PATH=`pwd`
export UTIL=${ANALYSIS_PATH}

export CXXFLAGS="-std=c++11 -Wall -fPIC -I. -I ${UTIL} -I ${ANALYSIS_PATH}"

# embed the library location in the executables, so that the analyzer
# libraries are found without setting LD_LIBRARY_PATH.
# $ORIGIN is resolved at run time as the directory of the executable
# itself: it must reach the linker verbatim, hence the single quotes.
RPATH='-Wl,-rpath,$ORIGIN' 

#####################################################################
# core libraries
#####################################################################

for LIB_NAME in AnalysisFramework AnalysisObjects AnalysisUtilities ; do
  echo "compile " ${LIB_NAME}
  cd ${ANALYSIS_PATH}/${LIB_NAME}
  rm -f ${ANALYSIS_PATH}/lib${LIB_NAME}.so
  c++ ${CXXFLAGS} -shared \
  -o ${ANALYSIS_PATH}/lib${LIB_NAME}.so *.cc                    || exit 1
done

#####################################################################
# analyzer plugins, one shared library each
#####################################################################

cd ${ANALYSIS_PATH}/AnalysisPlugins

echo "compile  EventDump"
rm -f ${ANALYSIS_PATH}/libEventDump.so
c++ ${CXXFLAGS} -shared \
-o ${ANALYSIS_PATH}/libEventDump.so EventDump.cc                 || exit 1

for LIB_NAME in ParticleMass ParticleLifetime ; do
  echo "compile " ${LIB_NAME}
  rm -f ${ANALYSIS_PATH}/lib${LIB_NAME}.so
  c++ ${CXXFLAGS} -shared `root-config --cflags` \
  -o ${ANALYSIS_PATH}/lib${LIB_NAME}.so ${LIB_NAME}.cc           || exit 1
done

#####################################################################
# executables: main lives in libAnalysisFramework.so, dum.cc is an
# empty translation unit, so --no-as-needed is required to keep the
# libraries linked in
#####################################################################

cd ${ANALYSIS_PATH}

export CORE_LIBS="-L ${ANALYSIS_PATH} -Wl,--no-as-needed \
-lAnalysisFramework -lAnalysisObjects -lAnalysisUtilities"

echo "compile  runDump"
rm -f runDump
c++ ${CXXFLAGS} -o runDump dum.cc ${RPATH} ${CORE_LIBS} \
-lEventDump                                                      || exit 1

echo "compile  runPlot"
rm -f runPlot
c++ ${CXXFLAGS} -o runPlot dum.cc ${RPATH} ${CORE_LIBS} \
-lParticleMass `root-config --libs`                              || exit 1

echo "compile  runLife"
rm -f runLife
c++ ${CXXFLAGS} -o runLife dum.cc ${RPATH} ${CORE_LIBS} \
-lParticleLifetime `root-config --libs`                          || exit 1

echo "compile  runAll"
rm -f runAll
c++ ${CXXFLAGS} -o runAll dum.cc ${RPATH} ${CORE_LIBS} \
-lEventDump -lParticleMass -lParticleLifetime `root-config --libs` || exit 1

#####################################################################

echo ""
echo "done."
